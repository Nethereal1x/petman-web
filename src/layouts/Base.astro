---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import fontCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site } from '../data/site';
import { clinicSchema, breadcrumbSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** хлібні крихти: [назва, шлях]; головна додається сама */
  crumbs?: [string, string][];
  schema?: object[];
  noindex?: boolean;
  /** картинка, яку варто завантажити першою (ім'я з маніфесту, ширина) */
  preloadImage?: { name: string; widths: number[]; sizes: string };
}

const { title, description, crumbs = [], schema = [], noindex = false, preloadImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;

const graph = [clinicSchema, ...(crumbs.length ? [breadcrumbSchema(crumbs)] : []), ...schema];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Petman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#d2460a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={fontCyr} as="font" type="font/woff2" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={preloadImage.widths.map((w) => `/img/${preloadImage.name}-${w}.avif ${w}w`).join(', ')}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    <script is:inline>
      // Анімації вмикаємо лише там, де про зменшення руху не просили.
      // Якщо основний скрипт не стартує за 4 с, знімаємо клас, щоб вміст не лишився прихованим.
      (function () {
        var root = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        setTimeout(function () {
          if (!window.__petmanReady) root.classList.remove('motion');
        }, 4000);
      })();
    </script>

    {graph.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#main">До змісту</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
