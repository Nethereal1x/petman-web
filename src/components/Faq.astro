---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq" data-faq>
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__body">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
