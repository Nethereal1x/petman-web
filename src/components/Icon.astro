---
interface Props {
  name: 'arrow' | 'phone' | 'chat' | 'pin' | 'calendar' | 'plus' | 'left' | 'right' | 'instagram';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M6 18 18 6M8 6h10v10" />}
  {name === 'left' && <path d="M19 12H5m6-6-6 6 6 6" />}
  {name === 'right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'phone' && (
    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />
  )}
  {name === 'chat' && (
    <path d="M4 5.5A2.5 2.5 0 0 1 6.500 3h11A2.500 2.500 0 0 1 20 5.500v8a2.500 2.500 0 0 1-2.500 2.500H12l-5 4.500V16h-.5A2.500 2.500 0 0 1 4 13.500v-8ZM8.500 8h7M8.500 11.500h4.500" />
  )}
  {name === 'instagram' && (
    <Fragment>
      <rect x="3.500" y="3.500" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.200 6.800h.01" />
    </Fragment>
  )}
  {name === 'pin' && (
    <Fragment>
      <path d="M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21Z" />
      <circle cx="12" cy="9.500" r="2.500" />
    </Fragment>
  )}
  {name === 'calendar' && <path d="M4 7.500A2.500 2.500 0 0 1 6.500 5h11A2.500 2.500 0 0 1 20 7.500v10a2.500 2.500 0 0 1-2.500 2.500h-11A2.500 2.500 0 0 1 4 17.500v-10ZM4 10h16M8.500 3v4M15.500 3v4" />}
</svg>
