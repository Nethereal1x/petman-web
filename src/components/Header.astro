---
import Icon from './Icon.astro';
import Img from './Img.astro';
import { site, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const hoursShort = site.hours
  .filter((h) => h.open)
  .map((h) => `${h.label} ${h.open}–${h.close}`)
  .join(' · ');
---

<header class="hdr" data-header>
  <div class="hdr__bar">
    <a class="logo" href="/" aria-label="Petman, на головну">
      <Img name="logo-mark" alt="" sizes="50px" loading="eager" />
      <span>Petman</span>
    </a>

    <nav class="hdr__nav" aria-label="Головне меню">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__meta">
      <a class="hdr__phone num" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <span class="hdr__status" data-open-status data-format="short">
        <span class="dot"></span>
        <span data-open-text>{hoursShort}</span>
      </span>
    </div>

    <a class="hdr__tel" href={`tel:${site.phone}`} aria-label={`Подзвонити: ${site.phoneDisplay}`}>
      <svg width="20" height="20"><use href="#i-phone"></use></svg>
    </a>

    <a class="btn btn--wine hdr__cta" href="/zapys/">
      <span>Записатися</span>
      <span class="btn__icon"><Icon name="arrow" /></span>
    </a>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Меню</span>
      <i aria-hidden="true"><span></span><span></span></i>
    </button>
  </div>
</header>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path>
  </symbol>
</svg>

<div class="menu t-wine" id="menu" data-menu aria-hidden="true">
  <nav class="menu__links" aria-label="Меню">
    <a href="/" style="--i:0">Головна</a>
    {
      nav.map((item, i) => (
        <a href={item.href} style={`--i:${i + 1}`}>
          {item.label}
        </a>
      ))
    }
    <a href="/zapys/" style={`--i:${nav.length + 1}`}>Записатися <small>онлайн</small></a>
  </nav>
  <div class="menu__foot">
    <a class="num" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    <span class="soft">{site.address.city}, {site.address.street}</span>
    <span class="soft">{hoursShort} · Нд вихідний</span>
  </div>
</div>

<style>
  .hdr__burger i {
    display: block;
  }
</style>
