---
// Калькулятор вартості стерилізації та кастрації.
// Найчастіше питання до клініки — «скільки коштує?»; тут відповідь за два кліки, з реального прайсу.
import Button from './Button.astro';
import { neuter } from '../data/services';
import { uah } from '../data/site';

const data = {
  catMale: { label: 'Кастрація кота', price: neuter.catMale },
  catFemale: { label: 'Стерилізація кішки', price: neuter.catFemale },
  dogMale: { label: 'Кастрація пса', bands: neuter.dogMale },
  dogFemale: { label: 'Стерилізація собаки', bands: neuter.dogFemale },
};

const who = [
  ['catMale', 'Кіт'],
  ['catFemale', 'Кішка'],
  ['dogMale', 'Пес'],
  ['dogFemale', 'Собака'],
];

interface Props {
  id?: string;
}

const { id = 'calc' } = Astro.props;
---

<div class="calc t-orange" data-calc data-prices={JSON.stringify(data)}>
  <fieldset class="calc__set">
    <legend>Хто пацієнт</legend>
    <div class="chips">
      {
        who.map(([value, label], i) => (
          <label class="chip">
            <input type="radio" name={`${id}-who`} value={value} checked={i === 0} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="calc__set calc__set--weight" data-calc-weight disabled>
    <legend>Вага <small data-calc-weight-hint>для котів ціна не залежить від ваги</small></legend>
    <div class="chips">
      {
        neuter.dogMale.map(([label], i) => (
          <label class="chip">
            <input type="radio" name={`${id}-weight`} value={i} checked={i === 1} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="calc__out" aria-live="polite" aria-atomic="true">
    <span class="calc__label" data-calc-label>{data.catMale.label}</span>
    <span class="calc__price num">
      <span data-calc-from hidden>від&nbsp;</span><span data-calc-value>{uah(neuter.catMale).replace(/\s*грн/, '')}</span
      ><small>&nbsp;грн</small>
    </span>
  </div>

  <div class="calc__foot">
    <p>Пакетна вартість планової операції. Склад пакета лікар пояснює до втручання.</p>
    <Button href="/zapys/?reason=sterylizatsiia-kastratsiia" variant="ink" icon="calendar">Записатися на операцію</Button>
  </div>
</div>

<style>
  .calc {
    display: grid;
    gap: clamp(1.5rem, 2.6vw, 2.5rem);
    padding: clamp(1.5rem, 3.2vw, 3.25rem);
    border-radius: calc(var(--radius) * 1.3);
  }

  .calc__set {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    transition: opacity 0.4s;
  }

  .calc__set[disabled] {
    opacity: 0.45;
  }

  .calc__set legend {
    padding: 0;
    margin-bottom: 0.85rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .calc__set legend small {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    margin-left: 0.5rem;
  }

  .calc__set:not([disabled]) legend small {
    display: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: inherit;
  }

  .chip span {
    display: block;
    padding: 0.8rem 1.25rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--white);
    font-weight: 650;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.5s var(--ease-out);
  }

  .chip input:checked + span {
    background: var(--white);
    color: var(--ink);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .calc__set:not([disabled]) .chip:hover input:not(:checked) + span {
      background: var(--ink);
      box-shadow: inset 0 0 0 1.5px var(--ink);
    }
  }

  .calc__set[disabled] .chip {
    cursor: default;
  }

  .calc__out {
    display: grid;
    gap: 0.5rem;
    padding-top: clamp(1.25rem, 2.2vw, 2rem);
    border-top: 1.5px solid var(--white);
  }

  .calc__label {
    font-weight: 650;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
  }

  .calc__price {
    font-size: clamp(3.6rem, 8.6vw, 8.75rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    font-weight: 500;
    white-space: nowrap;
  }

  .calc__price small {
    font-size: 0.3em;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .calc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .calc__foot p {
    max-width: 34ch;
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
