---
// Перелік послуг рядками: назва, що це, ціна «від» і перехід на сторінку послуги.
// На комп'ютері біля курсора показується фото напряму.
import Icon from './Icon.astro';
import manifest from '../data/images.json';
import { services } from '../data/services';
import { uah } from '../data/site';

const images = [...new Set(services.map((s) => s.image))];
---

<div class="svc-list" data-svc-list>
  <ol>
    {
      services.map((s, i) => (
        <li data-reveal>
          <a class="svc" href={`/posluhy/${s.slug}/`} data-svc data-img={s.image}>
            <span class="svc__num num">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc__name">{s.name}</span>
            <span class="svc__sum">{s.summary}</span>
            <span class="svc__price num">{s.from ? `від ${uah(s.from)}` : s.fromLabel}</span>
            <span class="svc__go">
              <Icon name="arrow" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="svc-float" aria-hidden="true" data-svc-float>
    {
      images.map((name) => (
        <img
          data-name={name}
          data-src={`/img/${name}-${manifest[name].widths[0]}.webp`}
          alt=""
          width={manifest[name].width}
          height={manifest[name].height}
          decoding="async"
        />
      ))
    }
  </div>
</div>

<style>
  .svc-list ol {
    border-top: 1px solid var(--line);
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.5fr) minmax(0, 1.15fr) minmax(9rem, auto) 3.25rem;
    gap: 1rem clamp(1rem, 2.5vw, 3rem);
    align-items: center;
    padding: clamp(1.1rem, 2vw, 1.9rem) clamp(0rem, 1.2vw, 1.5rem);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
    transition:
      color 0.35s var(--ease-out),
      padding 0.6s var(--ease-out);
  }

  .svc::before {
    content: '';
    position: absolute;
    inset: -1px 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.5s var(--ease-out);
  }

  .svc__num {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    transition: color 0.35s;
  }

  .svc__name {
    font-size: clamp(1.6rem, 3.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .svc__sum {
    color: var(--soft);
    font-size: 1rem;
    line-height: 1.4;
    max-width: 34ch;
    transition: color 0.35s;
  }

  .svc__price {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: right;
    white-space: nowrap;
  }

  .svc__go {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition:
      background-color 0.35s,
      color 0.35s,
      box-shadow 0.35s,
      transform 0.6s var(--ease-out);
  }

  .svc__go :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (hover: hover) {
    .svc:hover {
      color: var(--on-accent);
      padding-inline: clamp(0.75rem, 2.4vw, 3rem) clamp(0.75rem, 1.2vw, 1.5rem);
    }

    .svc:hover::before {
      transform: none;
    }

    .svc:hover .svc__num,
    .svc:hover .svc__sum {
      color: inherit;
    }

    .svc:hover .svc__go {
      background: var(--on-accent);
      color: var(--accent);
      box-shadow: none;
      transform: rotate(45deg);
    }
  }

  /* Фото, що їздить за курсором */
  .svc-float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: clamp(13rem, 17vw, 18rem);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    background: var(--ink);
  }

  .svc-float img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.18);
    transition:
      opacity 0.35s,
      transform 0.9s var(--ease-out);
  }

  .svc-float img.is-on {
    opacity: 1;
    transform: none;
  }

  @media (hover: none), (max-width: 960px) {
    .svc-float {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .svc {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'num go'
        'name go'
        'sum sum'
        'price price';
      gap: 0.35rem 1rem;
      padding-block: 1.25rem;
    }

    .svc__num {
      grid-area: num;
    }

    .svc__name {
      grid-area: name;
      font-size: clamp(1.7rem, 7.4vw, 2.6rem);
    }

    .svc__sum {
      grid-area: sum;
      margin-top: 0.4rem;
    }

    .svc__price {
      grid-area: price;
      text-align: left;
      margin-top: 0.35rem;
      color: var(--accent);
    }

    .svc__go {
      grid-area: go;
      width: 2.75rem;
      height: 2.75rem;
      align-self: center;
    }
  }
</style>
