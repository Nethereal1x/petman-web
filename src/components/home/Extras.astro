---
// Грумінг і зоомагазин: половина бізнесу, якої не було на старому сайті.
// Дві великі панелі-посилання на окремі сторінки.
import Icon from '../Icon.astro';
import Img from '../Img.astro';
---

<section class="extras" aria-label="Грумінг і зоомагазин">
  <a class="panel t-orange" href="/posluhy/hruminh/">
    <span class="eyebrow">Не лише лікування</span>
    <h2 class="panel__title" data-split>Грумінг</h2>
    <p class="panel__text">
      Салон під одним дахом із клінікою. Якщо грумер помітить щось на шкірі чи у вухах, поруч є лікар.
    </p>
    <span class="panel__go"><Icon name="arrow" /></span>
    <span class="panel__pic" data-parallax="6">
      <Img name="clinic-reception" alt="Рудий пудель після грумінгу на рецепції Petman" sizes="(max-width: 860px) 40vw, 18vw" />
    </span>
  </a>

  <a class="panel t-ink" href="/posluhy/zoomahazyn/">
    <span class="eyebrow">У тому ж приміщенні</span>
    <h2 class="panel__title" data-split>Зоомагазин</h2>
    <p class="panel__text">
      Корм чи засіб для догляду, який порадив лікар, можна купити одразу після прийому.
    </p>
    <span class="panel__go"><Icon name="arrow" /></span>
    <span class="panel__pic panel__pic--cut" data-parallax="-5">
      <Img name="dog-golden" alt="Золотистий ретривер" sizes="(max-width: 860px) 46vw, 22vw" />
    </span>
  </a>
</section>

<style>
  .extras {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .panel {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1.25rem;
    min-height: clamp(30rem, 52vw, 46rem);
    padding: clamp(2.5rem, 6vw, 6rem) var(--gutter) clamp(2rem, 4vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .panel__title {
    font-size: clamp(3rem, 8.4vw, 9.25rem);
    line-height: 0.9;
    letter-spacing: -0.058em;
    font-weight: 500;
  }

  .panel__text {
    max-width: 26ch;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    line-height: 1.38;
    font-weight: 500;
    letter-spacing: -0.012em;
  }

  .panel__go {
    display: grid;
    place-items: center;
    width: clamp(4rem, 6vw, 5.5rem);
    height: clamp(4rem, 6vw, 5.5rem);
    margin-top: auto;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: transform 0.7s var(--ease-out);
  }

  .panel__go :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .panel__pic {
    position: absolute;
    z-index: -1;
    right: var(--gutter);
    bottom: clamp(2rem, 4vw, 4rem);
    width: clamp(9rem, 19vw, 19rem);
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .panel__pic :global(picture),
  .panel__pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .panel__pic--cut {
    right: 0;
    bottom: 0;
    width: clamp(11rem, 24vw, 25rem);
    aspect-ratio: auto;
    border-radius: 0;
    overflow: visible;
  }

  .panel__pic--cut :global(img) {
    height: auto;
    transform-origin: 50% 100%;
  }

  @media (hover: hover) {
    .panel:hover .panel__go {
      transform: rotate(45deg) scale(1.08);
    }

    .panel:hover .panel__pic :global(img) {
      transform: scale(1.06);
    }
  }

  @media (max-width: 860px) {
    .extras {
      grid-template-columns: 1fr;
    }

    .panel {
      min-height: 27rem;
    }

    .panel__text {
      max-width: 22ch;
    }
  }
</style>
