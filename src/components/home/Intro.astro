---
// Блок одразу після першого екрана. Відповідає на питання «чому сюди»:
// підхід клініки одним абзацом і три факти, які можна перевірити в Google.
import Img from '../Img.astro';
import { site, formatDate } from '../../data/site';

const { rating } = site;
---

<section class="intro t-white" data-wipe>
  <div class="wrap">
    <div class="intro__top">
      <p class="eyebrow">Про клініку</p>
      <p class="intro__text" data-fill>
        Для вас це не просто кіт чи собака, а член родини. Тому ми спершу слухаємо вас, потім пояснюємо кожне рішення
        і називаємо вартість до процедури, а не після.
      </p>
    </div>

    <div class="intro__grid">
      <ul class="facts">
        <li>
          <span class="facts__num num"><span data-count="4.8" data-decimals="1">4,8</span></span>
          <span class="facts__label">
            середня оцінка в Google.{' '}
            <a class="link" href={site.links.maps} target="_blank" rel="noopener">Читати відгуки</a>
          </span>
        </li>
        <li>
          <span class="facts__num num"
            ><span data-count={rating.fiveStar}>{rating.fiveStar}</span><small>&nbsp;з&nbsp;{rating.count}</small></span
          >
          <span class="facts__label">відгуків мають п’ять зірок. Дані на {formatDate(rating.asOf)}</span>
        </li>
        <li>
          <span class="facts__num num"><span data-count="6">6</span><small>&nbsp;днів</small></span>
          <span class="facts__label">на тиждень: у будні до 20:00, у суботу до 18:00</span>
        </li>
      </ul>

      <div class="intro__photos">
        <figure class="intro__photo intro__photo--a" data-parallax="-7">
          <Img
            name="clinic-reception"
            alt="Рудий пудель на рецепції клініки Petman"
            sizes="(max-width: 860px) 58vw, 24vw"
          />
        </figure>
        <figure class="intro__photo intro__photo--b" data-parallax="9">
          <Img name="clinic-cat" alt="Чорно-білий кіт на оглядовому столі" sizes="(max-width: 860px) 46vw, 19vw" />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    z-index: 5;
    padding-block: clamp(5rem, 11vw, 11rem) var(--section);
  }

  .intro__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3.4fr);
    gap: 1.5rem var(--gutter);
    align-items: start;
  }

  .intro__top .eyebrow {
    padding-top: 1.1em;
    color: var(--orange);
  }

  .intro__text {
    font-size: clamp(1.75rem, 4.15vw, 4.35rem);
    line-height: 1.06;
    letter-spacing: -0.042em;
    font-weight: 500;
    max-width: 24ch;
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem var(--gutter);
    align-items: end;
    margin-top: clamp(3.5rem, 8vw, 8rem);
  }

  .facts {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .facts li {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: end;
    padding: clamp(1.1rem, 2vw, 1.9rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .facts__num {
    font-size: clamp(3.25rem, 7.4vw, 7.75rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-weight: 500;
    color: var(--orange);
    white-space: nowrap;
  }

  .facts__num small {
    font-size: 0.3em;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
  }

  .facts__label {
    color: var(--soft);
    max-width: 28ch;
    padding-bottom: 0.3rem;
  }

  .intro__photos {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(0.75rem, 1.4vw, 1.5rem);
    align-items: end;
  }

  .intro__photo {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--orange);
  }

  .intro__photo--a {
    aspect-ratio: 3 / 4;
  }

  .intro__photo--b {
    aspect-ratio: 4 / 5;
    margin-bottom: clamp(2rem, 6vw, 6rem);
  }

  .intro__photo :global(picture),
  .intro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .intro__top,
    .intro__grid {
      grid-template-columns: 1fr;
    }

    .intro__top .eyebrow {
      padding-top: 0;
    }

    .intro__photos {
      order: -1;
    }

    .facts li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
