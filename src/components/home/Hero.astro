---
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import { site } from '../../data/site';
---

<section class="hero t-orange" data-hero>
  <div class="hero__dog" data-hero-dog>
    <Img
      name="dog-lab"
      alt="Чорний лабрадор у червоній масці та плащі супергероя"
      sizes="(max-width: 860px) 74vw, 46vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__word" aria-hidden="true">
    <span data-hero-word>Petman</span>
  </div>

  <div class="wrap hero__content">
    <h1 class="hero__h1">
      <span class="eyebrow hero__eyebrow" data-hero-fade>Ветеринарна клініка у Львові</span>
      <span class="display hero__title">
        <span class="hero__line"><span data-hero-line>До кожного&nbsp;—</span></span>
        <span class="hero__line"><span data-hero-line>як до свого</span></span>
      </span>
    </h1>

    <p class="lead hero__lead" data-hero-fade>
      Лікуємо котів і собак на Антоновича, 115а. Слухаємо власника, пояснюємо кожне рішення і називаємо ціну до
      процедури.
    </p>

    <div class="hero__bottom">
      <a class="circle" href="/zapys/" data-magnetic data-hero-circle>
        <span class="circle__in" data-magnetic-inner>
          <span>Записатися<br />на прийом</span>
          <Icon name="arrow" />
        </span>
      </a>

      <a class="status" href="/kontakty/" data-open-status data-format="long" data-hero-fade>
        <span class="status__top"><span class="dot"></span><span data-open-label>Графік роботи</span></span>
        <span class="status__big num" data-open-text>Пн–Пт 10:00–20:00</span>
        <span class="status__sub">{site.address.street} · Сб до 18:00</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 40rem;
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: clamp(6.75rem, 11.5vw, 10.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  .hero__h1 {
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.75rem);
    justify-items: start;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* запас, щоб маска не зрізала виносні елементи літер */
    padding: 0.06em 0.06em 0.12em;
    margin: -0.06em -0.06em -0.12em;
  }

  .hero__line > span {
    display: block;
    white-space: nowrap;
  }

  .hero__lead {
    max-width: 30ch;
    margin-top: clamp(1.25rem, 2.2vw, 2.25rem);
    color: var(--white);
  }

  .hero__bottom {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }

  /* Собака */
  .hero__dog {
    position: absolute;
    z-index: 1;
    top: 13svh;
    /* фото обрізане справа, тож цей край ховаємо за межею екрана */
    right: -3.5vw;
    width: clamp(22rem, 46vw, 51rem);
    pointer-events: none;
    will-change: transform;
  }

  .hero__dog :global(img) {
    width: 100%;
  }

  /* Велике слово поверх собаки */
  .hero__word {
    position: absolute;
    z-index: 2;
    right: -1vw;
    bottom: -0.17em;
    font-size: clamp(7rem, 17.6vw, 21.5rem);
    line-height: 0.8;
    letter-spacing: -0.075em;
    font-weight: 700;
    color: var(--white);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .hero__word span {
    display: block;
    will-change: transform;
  }

  /* Кругла кнопка запису */
  .circle {
    --size: clamp(8.5rem, 12.5vw, 12rem);
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    font-weight: 650;
    font-size: clamp(0.92rem, 1.05vw, 1.05rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-align: center;
    isolation: isolate;
    overflow: hidden;
    transition: color 0.4s var(--ease-out);
  }

  .circle::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--wine);
    transform: scale(0);
    transition: transform 0.6s var(--ease-out);
  }

  .circle__in {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
  }

  .circle :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.5s var(--ease-out);
  }

  @media (hover: hover) {
    .circle:hover {
      color: var(--white);
    }

    .circle:hover::before {
      transform: scale(1.02);
    }

    .circle:hover :global(svg) {
      transform: translate(0.25rem, -0.25rem);
    }
  }

  /* Картка «зараз відчинено» */
  .status {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.35rem 1.2rem;
    border-radius: var(--radius);
    background: var(--wine);
    color: var(--white);
    min-width: 15.5rem;
    transition: background-color 0.35s;
  }

  .status__top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status[data-open='true'] .dot {
    background: #3ddc7c;
  }

  .status[data-open='false'] .dot {
    background: var(--orange-hot);
  }

  .status__big {
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .status__sub {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (hover: hover) {
    .status:hover {
      background: var(--ink);
    }
  }

  @media (max-width: 860px) {
    .hero {
      height: calc(100svh - var(--bar-h));
      min-height: 37rem;
    }

    .hero__content {
      padding-top: 6.25rem;
      padding-bottom: 1rem;
    }

    .hero__lead {
      max-width: 24ch;
      font-size: 1.0625rem;
    }

    .hero__dog {
      top: auto;
      /* голова собаки має опинитися між карткою графіка і великим словом */
      bottom: -52vw;
      right: -9vw;
      width: 74vw;
    }

    .hero__word {
      font-size: 31vw;
      right: auto;
      left: -1vw;
      bottom: -0.16em;
    }

    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      /* підіймаємо над великим словом */
      margin-bottom: 21vw;
    }

    .circle {
      --size: 7.75rem;
      font-size: 0.9rem;
    }

    .status {
      order: -1;
      min-width: 0;
      padding: 0.8rem 1rem 0.85rem;
      border-radius: 16px;
    }

    .status__big {
      font-size: 1.2rem;
    }

    .status__sub {
      display: none;
    }
  }

  @media (max-width: 860px) and (max-height: 700px) {
    .status {
      display: none;
    }
  }
</style>
